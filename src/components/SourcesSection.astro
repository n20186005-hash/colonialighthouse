---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.sources;
---

<section id="sources" class="section-padding" style="background: var(--bg-secondary);">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="font-display text-3xl sm:text-4xl font-semibold mb-3 text-center" style="color: var(--text-primary);">{s.title}</h2>
    <p class="text-center text-base sm:text-lg mb-10" style="color: var(--text-secondary);">{s.subtitle}</p>

    <ul class="grid sm:grid-cols-2 gap-4">
      {s.items.map((it) => (
        <li>
          <a href={it.url} target="_blank" rel="noopener noreferrer"
             class="block h-full rounded-2xl p-5 border transition hover:opacity-90" style="background: var(--card-bg); border-color: var(--border-color); box-shadow: var(--card-shadow);">
            <div class="font-semibold text-base" style="color: var(--text-primary);">{it.name}</div>
            <div class="text-xs mt-1" style="color: var(--accent);">{it.publisher} ↗</div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
